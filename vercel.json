{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "null",
  "buildCommand": "pnpm --filter api build",
  "outputDirectory": "apps/api/dist",
  "functions": {
    "api/index.mjs": {
      "includeFiles": "src/generated/prisma/**",
      "maxDuration": 60
    }
  },
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "/api"
    },
    {
      "source": "/(dashboard|analytics|settings|identify|links|billing)(/.*)?",
      "destination": "/index.html"
    },
    {
      "source": "/",
      "destination": "/index.html"
    },
    {
      "source": "/((?!assets/|favicon.svg|icons.svg).*)",
      "destination": "/api/index.mjs"
    }
  ],
  "headers": [
    {
      "source": "/api/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache, no-store, must-revalidate"
        },
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        }
      ]
    }
  ]
}
