# ==========================================
# BACKEND ENVIRONMENT VARIABLES (apps/api)
# ==========================================

# Node Environment
NODE_ENV=production

# Server Configuration
PORT=3000

# Database Configuration
# For Neon: Use pooled URL for app connections (DATABASE_URL)
# and direct URL for migrations (DIRECT_DATABASE_URL)
DATABASE_URL=postgresql://user:password@ep-example.us-east-1.aws.neon.tech/dbname?sslmode=require
DIRECT_DATABASE_URL=postgresql://user:password@ep-example.us-east-1.aws.neon.tech/dbname?sslmode=require

# JWT Secrets (REQUIRED IN PRODUCTION)
# Generate strong secrets with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_ACCESS_SECRET=your_strong_access_secret_here_min_32_chars
JWT_REFRESH_SECRET=your_strong_refresh_secret_here_min_32_chars
JWT_SECRET=fallback_secret_if_specific_ones_not_set

# JWT Token Expiry
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# CORS Configuration
# Comma-separated list of allowed origins
CORS_ORIGINS=https://your-frontend.vercel.app,https://your-domain.com

# Public URL (for redirects and links)
PUBLIC_URL=https://your-shortener-domain.com

# Cookie Configuration
COOKIE_SECURE=true
COOKIE_SAME_SITE=lax

# Logging Level (debug, info, warn, error)
LOG_LEVEL=info

# Reserved Slugs (comma-separated)
NOT_ALLOWED_SLUG=analytics,links,settings,identify,api

# OPTIONAL: URL Blocking (for malicious/phishing URLs)
# GOOGLE_SAFE_BROWSING_API_KEY=your_api_key_here
