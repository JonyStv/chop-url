# ==========================================
# BACKEND ENVIRONMENT VARIABLES (apps/api)
# ==========================================

# Entorno de ejecución (Vercel lo establece automáticamente en 'production')
NODE_ENV=production

# Puerto del servidor (opcional en despliegues Serverless/Vercel)
PORT=3000

# Base de datos PostgreSQL (Obligatorio, p.ej. Neon, Supabase, Railway)
DATABASE_URL=postgresql://usuario:contraseña@ep-ejemplo.us-east-1.aws.neon.tech/neondb?sslmode=require

# Secrets para Tokens JWT (Obligatorios en producción)
# Puedes usar JWT_SECRET como fallback único o definir ambos individualmente
JWT_SECRET=tu_clave_secreta_jwt_muy_segura_aqui
JWT_ACCESS_SECRET=tu_clave_secreta_access_token
JWT_REFRESH_SECRET=tu_clave_secreta_refresh_token

# Tiempos de expiración de Tokens (Opcionales)
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# Configuración de CORS y URLs (Recomendado para Vercel)
# Dominio(s) permitidos para peticiones desde el Frontend (separados por coma)
CORS_ORIGINS=https://tu-app.vercel.app
PUBLIC_URL=https://tu-app.vercel.app

# Configuración de Cookies (Opcional, por defecto en prod: COOKIE_SECURE=true, COOKIE_SAME_SITE=none)
COOKIE_SECURE=true
COOKIE_SAME_SITE=none

# Configuración de Slugs reservados y Logs
NOT_ALLOWED_SLUG=analytics,links,settings,identify,api
LOG_LEVEL=info
