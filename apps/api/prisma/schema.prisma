generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model analiticas {
  id          String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  enlace_id   String    @db.Uuid
  usuario_id  String    @db.Uuid
  visitor_id  String    @db.VarChar(255)
  ip          String?   @db.VarChar(50)
  country     String?   @db.VarChar(50)
  city        String?   @db.VarChar(50)
  browser     String?   @db.VarChar(50)
  os          String?   @db.VarChar(50)
  device_type String?   @db.VarChar(50)
  referrer    String?   @db.VarChar(50)
  timestamp   DateTime? @default(now()) @db.Timestamptz(6)
  enlaces     enlaces   @relation(fields: [enlace_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "fk_analytics_enlace")
  usuarios    usuarios  @relation(fields: [usuario_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "fk_analytics_usuario")

  @@index([enlace_id], map: "idx_analiticas_enlace_id")
  @@index([timestamp], map: "idx_analiticas_timestamp")
  @@index([usuario_id], map: "idx_analiticas_usuario_id")
}

model enlaces {
  id             String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  usuario_id     String       @db.Uuid
  slug           String       @unique @db.VarChar(50)
  url_original   String
  titulo         String?      @db.VarChar(100)
  fecha_creacion DateTime?    @default(now()) @db.Timestamptz(6)
  estado         String       @default("Activo") @db.VarChar(100)
  total_clicks   Int?         @default(0)
  analiticas     analiticas[]
  usuarios       usuarios     @relation(fields: [usuario_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "fk_enlaces_usuario")
}

model sesiones {
  id               String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  usuario_id       String   @db.Uuid
  token            String   @unique
  fecha_creacion   DateTime @default(now()) @db.Timestamptz(6)
  fecha_expiracion DateTime @db.Timestamptz(6)
  ip               String?  @db.VarChar(50)
  dispositivo      String?
  usuarios         usuarios @relation(fields: [usuario_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "fk_sesiones_usuario")

  @@index([token], map: "idx_sesiones_token")
  @@index([usuario_id], map: "idx_sesiones_usuario_id")
}

model usuarios {
  id             String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  email          String       @unique @db.VarChar(100)
  password       String       @db.VarChar(255)
  nombre         String       @db.VarChar(50)
  fecha_registro DateTime     @default(now()) @db.Timestamptz(6)
  plan           String       @default("gratuito") @db.VarChar(30)
  limite_enlaces Int          @default(10)
  activo         Boolean      @default(true)
  analiticas     analiticas[]
  enlaces        enlaces[]
  sesiones       sesiones[]
}
